# Copy to .env.local and fill in. Never commit .env.local.

# NYC Open Data (Socrata). Use ONE of the two options below.
# Without either, requests still work but are rate-limited.

# Option A - API Key (Developer Settings > API Keys). Needs BOTH values;
# the secret is shown only once, at creation.
SOCRATA_API_KEY_ID=
SOCRATA_API_KEY_SECRET=

# Option B - App Token (Developer Settings > App Tokens). Single value.
# SOCRATA_APP_TOKEN=

# Gemini (Google AI Studio - free tier). Without it the plain-English
# summary is silently omitted; everything else works.
GEMINI_API_KEY=

# ElevenLabs narration (optional). Key needs the Text to Speech scope;
# a 401 usually means the scope is missing, not that the key is wrong.
# Without it the Listen button is simply not rendered.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=   # defaults to Rachel, a stock voice

# Tiger Data / TimescaleDB (optional). Speeds up area rent and stabilization
# lookups ~39x; without it both fall back to downloading the source CSVs.
# Keep sslmode=require; the client appends uselibpqcompat=true itself.
DATABASE_URL=
