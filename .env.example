# Copy to .env.local and fill in. Never commit .env.local.

# NYC Open Data (Socrata). Use ONE of the two options below.
# Without either, requests still work but are rate-limited.

# Option A - API Key (Developer Settings > API Keys). Needs BOTH values;
# the secret is shown only once, at creation.
SOCRATA_API_KEY_ID=
SOCRATA_API_KEY_SECRET=

# Option B - App Token (Developer Settings > App Tokens). Single value.
# SOCRATA_APP_TOKEN=
